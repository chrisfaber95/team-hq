{
  "crossSessionInbound": "refuse",
  "isolatePeerMachines": true,
  "permissions": {
    "allow": [
      "Bash(git fetch *)",
      "Bash(git merge *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * main)",
      "Bash(gh pr merge *)",
      "Bash(gh release *)",
      "Edit",
      "Write"
    ]
  }
}
