{
  "permissions": {
    "allow": [
      "Bash(bash scripts/dispatch.sh *)",
      "Bash(bash scripts/review.sh *)",
      "Bash(bash scripts/merge.sh *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(bash scripts/baseline.sh *)",
      "Bash(bash scripts/plan.sh *)",
      "Bash(bash scripts/run-tickets.sh *)",
      "Bash(bash scripts/epic.sh *)"
    ],
    "deny": [
      "Edit(//n/Projects/**)",
      "Edit(//n/worktrees/**)",
      "Bash(gh pr merge *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ],
    "defaultMode": "auto"
  },
  "isolatePeerMachines": true,
  "crossSessionInbound": "accept"
}
