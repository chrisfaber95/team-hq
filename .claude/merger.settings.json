{
  "crossSessionInbound": "refuse",
  "isolatePeerMachines": true,
  "permissions": {
    "allow": [
      "Bash(gh pr merge *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(gh release *)",
      "Edit",
      "Write"
    ]
  }
}
